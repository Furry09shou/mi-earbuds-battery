<Window x:Class="RonghuiEarbuds.Setup.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绒汇耳机助手 卸载程序" Width="460" Height="342"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="14" Background="#141417"
            BorderBrush="#2B2B31" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#E87A3E" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblTitleBar" Text="卸载程序" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="#EDEDF0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,54,0">
                    <Button x:Name="LangBtnZh" Style="{StaticResource SegLangButton}" Tag="zh" Content="中文"
                            BorderBrush="#E87A3E" Foreground="#EDEDF0" FontWeight="SemiBold"
                            Click="LangButton_Click"/>
                    <Button x:Name="LangBtnEn" Style="{StaticResource SegLangButton}" Tag="en" Content="English"
                            Margin="6,0,0,0" Click="LangButton_Click"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="28,4,28,24">

                <!-- 确认面板 -->
                <StackPanel x:Name="ConfirmPanel">
                    <Border Width="46" Height="46" CornerRadius="23" Background="#1C1C21"
                            HorizontalAlignment="Center">
                        <Image x:Name="LogoImage" Width="36" Height="36"/>
                    </Border>
                    <TextBlock x:Name="LblConfirmTitle" Text="卸载 绒汇耳机助手？" FontSize="16.5" FontWeight="SemiBold"
                               Foreground="#EDEDF0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="LblConfirmBody" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                               FontSize="11.5" Foreground="#8F8F98" Margin="0,6,0,0"
                               Text="将移除程序文件、开机自启项与快捷方式。你的耳机绑定信息可一并删除，或保留供下次安装使用。"/>
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                        <CheckBox x:Name="DeleteConfigCheck" Style="{StaticResource ToggleCheck}"
                                  Content="同时删除配置与绑定信息"/>
                    </StackPanel>
                    <TextBlock Text="© 绒汇公共交通组织 · RonghuiEarbuds" FontSize="10.5"
                               Foreground="#5C5C66" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="取消"
                                Click="CloseButton_Click"/>
                        <Button x:Name="UninstallConfirmButton" Style="{StaticResource DangerButton}" Content="卸载" Width="120"
                                Height="36" Margin="10,0,0,0" Click="UninstallButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 进行中面板 -->
                <StackPanel x:Name="BusyPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Canvas Width="40" Height="40" HorizontalAlignment="Center">
                        <Path x:Name="SpinnerArc" Data="M 20 4 A 16 16 0 1 0 36 20"
                              Stroke="#E87A3E" StrokeThickness="3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <TextBlock x:Name="LblBusyText" Text="正在卸载…" FontSize="12.5" Foreground="#8F8F98"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- 完成面板 -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27" Background="#243A28"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="DoneIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" Foreground="#6FBF73" HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="DoneScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <TextBlock x:Name="LblDoneTitle" Text="卸载完成" FontSize="16" FontWeight="SemiBold" Foreground="#EDEDF0"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="DoneSubText" Text="程序文件已移除" FontSize="11.5"
                               Foreground="#8F8F98" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 异常面板（校验失败等） -->
                <StackPanel x:Name="WarnPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27" Background="#3A2626"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="#D96A5B" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="WarnText" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="360" FontSize="12.5" Foreground="#D96A5B" Margin="0,14,0,0"
                               Text=""/>
                    <Button x:Name="CloseWarnButton" Style="{StaticResource GhostButton}" Content="关闭" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
