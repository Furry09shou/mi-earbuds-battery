<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms 仅提供 FolderBrowserDialog，禁止其全局 using 污染 WPF 代码 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RonghuiEarbuds.Setup</AssemblyName>
    <RootNamespace>RonghuiEarbuds.Setup</RootNamespace>
    <ApplicationIcon>..\..\assets\RonghuiEarbuds.ico</ApplicationIcon>
    <Version>1.8.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="RonghuiEarbuds.Logo.png" />
  </ItemGroup>

  <!-- 把主程序 Release 产物打成 zip 并内嵌进安装器 exe（单文件分发）。
       依赖主程序已先构建（build.cmd 保证顺序）。 -->
  <Target Name="PrepareAppPayload" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <PayloadSrc>..\..\src\RonghuiEarbuds.App\bin\Release\net10.0-windows10.0.19041.0</PayloadSrc>
      <PayloadWork>$(IntermediateOutputPath)payload\</PayloadWork>
    </PropertyGroup>
    <ItemGroup>
      <AppFiles Include="$(PayloadSrc)\**\*.*" Exclude="$(PayloadSrc)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(AppFiles)"
          DestinationFiles="@(AppFiles->'$(PayloadWork)app\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(PayloadWork)app.zip" />
    <ZipDirectory SourceDirectory="$(PayloadWork)app" DestinationFile="$(PayloadWork)app.zip" />
    <ItemGroup>
      <EmbeddedResource Include="$(PayloadWork)app.zip" LogicalName="RonghuiEarbuds.Payload.zip" />
    </ItemGroup>
  </Target>
  <!-- 小组件插件 payload（存在才嵌入，安装器勾选项可在 Win11 上一键装/升级） -->
  <Target Name="PrepareWidgetPayload" BeforeTargets="AssignTargetPaths"
          Condition="Exists('..\..\widget\pkg\RonghuiEarbuds.Widgets.msix')">
    <ItemGroup>
      <EmbeddedResource Include="..\..\widget\pkg\RonghuiEarbuds.Widgets.msix" LogicalName="RonghuiEarbuds.Widget.msix" />
      <EmbeddedResource Include="..\..\widget\pkg\RonghuiEarbuds.cer" LogicalName="RonghuiEarbuds.Widget.cer" />
    </ItemGroup>
  </Target>
</Project>
