<Window x:Class="RonghuiEarbuds.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绒汇耳机助手 安装程序" Width="460" Height="504"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="14" Background="#141417"
            BorderBrush="#2B2B31" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#E87A3E" VerticalAlignment="Center"/>
                    <TextBlock Text="安装程序" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="#EDEDF0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="28,4,28,24">

                <!-- 就绪面板 -->
                <StackPanel x:Name="ReadyPanel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#1C1C21">
                            <Image x:Name="LogoImage" Width="36" Height="36"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="绒汇耳机助手" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#EDEDF0" VerticalAlignment="Center"/>
                                <Border Background="#243A28" CornerRadius="5" Padding="7,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10.5"
                                               Foreground="#6FBF73"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="耳机 BLE 电量监控 · 安装到你的电脑" FontSize="11.5"
                                       Foreground="#8F8F98" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 已安装检测横幅 -->
                    <Border x:Name="ExistBanner" Background="#2A2118" BorderBrush="#4A3A22"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#E8A33E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExistText" Margin="8,0,0,0" FontSize="11.5"
                                       Foreground="#E8A33E" TextWrapping="Wrap" MaxWidth="330"
                                       VerticalAlignment="Center" Text=""/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="安装位置" FontSize="11.5" Foreground="#C9C9CF" Margin="0,20,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Style="{StaticResource DarkInput}"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Content="浏览…" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="ResolvedText" FontSize="10.5" Foreground="#5C5C66"
                               Margin="2,6,0,0" TextWrapping="Wrap" Text=""/>

                    <StackPanel Margin="0,16,0,0">
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource ToggleCheck}"
                                  Content="开机自启（登录后静默运行）" IsChecked="True"/>
                        <CheckBox x:Name="DesktopCheck" Style="{StaticResource ToggleCheck}"
                                  Content="创建桌面快捷方式" IsChecked="True" Margin="0,8,0,0"/>
                        <CheckBox x:Name="StartMenuCheck" Style="{StaticResource ToggleCheck}"
                                  Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Button x:Name="InstallButton" Style="{StaticResource AccentButton}"
                            Content="安装" Margin="0,18,0,0" Click="InstallButton_Click"/>

                    <TextBlock Text="© 绒汇公共交通组织 · RonghuiEarbuds" FontSize="10.5"
                               Foreground="#5C5C66" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 安装中面板 -->
                <StackPanel x:Name="BusyPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Canvas Width="40" Height="40" HorizontalAlignment="Center">
                        <Path x:Name="SpinnerArc" Data="M 20 4 A 16 16 0 1 0 36 20"
                              Stroke="#E87A3E" StrokeThickness="3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <TextBlock x:Name="BusyText" Text="正在安装…" FontSize="12.5" Foreground="#8F8F98"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- 完成面板 -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27" Background="#243A28"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="DoneIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" Foreground="#6FBF73" HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="DoneScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="安装完成" FontSize="16" FontWeight="SemiBold" Foreground="#EDEDF0"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="DoneSubText" Text="程序已安装到所选位置" FontSize="11.5"
                               Foreground="#8F8F98" HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="完成"
                                Click="CloseButton_Click"/>
                        <Button x:Name="RunButton" Style="{StaticResource AccentButton}"
                                Content="立即运行" Width="120" Height="36" Margin="10,0,0,0"
                                Click="RunButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 错误面板 -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27" Background="#3A2626"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="#D96A5B" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ErrorText" FontSize="12.5" Foreground="#D96A5B"
                               HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap"
                               MaxWidth="360" TextAlignment="Center" Text=""/>
                    <Button Style="{StaticResource GhostButton}" Content="重试" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Click="RetryButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
