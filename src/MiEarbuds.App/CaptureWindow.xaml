<Window x:Class="MiEarbuds.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="适配名单" Width="384" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModelBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C21"/>
            <Setter Property="Foreground" Value="#EDEDF0"/>
            <Setter Property="CaretBrush" Value="#E87A3E"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- 向导大步骤页样式 -->
        <Style x:Key="StepTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#EDEDF0"/>
        </Style>
        <Style x:Key="StepDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#8F8F98"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#141417" BorderBrush="#2B2B31" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#E87A3E" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="适配名单" Margin="8,0,0,0" FontSize="13"
                               FontWeight="SemiBold" Foreground="#EDEDF0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                        Click="BackButton_Click"/>
            </Grid>

            <!-- 向导进度点（仅向导视图可见） -->
            <StackPanel x:Name="DotsRow" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,2,0,4" Visibility="Collapsed"/>

            <!-- 内容区：所有视图叠放，切换可见性 -->
            <Grid x:Name="Views" Grid.Row="2" Margin="20,0,20,0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ViewsTranslate" Y="0"/>
                </Grid.RenderTransform>

                <!-- ============ 视图：适配名单 ============ -->
                <StackPanel x:Name="ListPage">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#8F8F98"
                               Text="以下机型已完成协议适配，软件可实时显示电量。列表随版本更新持续增加。"/>
                    <ItemsControl x:Name="ModelList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#19191E" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#243A28">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="#6FBF73" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#EDEDF0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Border Background="#243A28" CornerRadius="5" Padding="7,2" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="已支持" FontSize="10" Foreground="#6FBF73"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#8F8F98" Margin="0,4,0,0"
                               Text="没找到你的耳机？点右下角「适配新耳机」，按向导采集广播数据即可众包适配。"/>
                </StackPanel>

                <!-- ============ 向导页 0：写入型号 ============ -->
                <StackPanel x:Name="Page0" Visibility="Collapsed">
                    <TextBlock Text="先写下耳机型号" FontSize="21" FontWeight="Bold" Foreground="#EDEDF0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8F8F98" Margin="0,8,0,0"
                               Text="你的耳机型号暂不受支持？按向导做几个简单动作，软件会记录耳机的广播数据用于破解协议。数据不含个人隐私。"/>
                    <TextBlock Text="耳机型号名称" FontSize="11.5" Foreground="#C9C9CF" Margin="0,14,0,6"/>
                    <TextBox x:Name="ModelBox" Style="{StaticResource ModelBoxStyle}"
                             Text="例如：Redmi Buds 5" Foreground="#5C5C66"
                             GotFocus="ModelBox_GotFocus" LostFocus="ModelBox_LostFocus"/>
                    <TextBlock x:Name="ModelHint" Text="请先填写耳机型号" FontSize="11" Foreground="#D96A5B"
                               Margin="2,6,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ============ 向导页 1-5：动作步骤 ============ -->
                <StackPanel x:Name="Page1" Visibility="Collapsed">
                    <TextBlock x:Name="StepNum1" Text="步骤 1 / 5" FontSize="11.5" Foreground="#E87A3E"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepTitle1" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StepDetail1" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock x:Name="StepNum2" Text="步骤 2 / 5" FontSize="11.5" Foreground="#E87A3E"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepTitle2" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StepDetail2" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Page3" Visibility="Collapsed">
                    <TextBlock x:Name="StepNum3" Text="步骤 3 / 5" FontSize="11.5" Foreground="#E87A3E"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepTitle3" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StepDetail3" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Page4" Visibility="Collapsed">
                    <TextBlock x:Name="StepNum4" Text="步骤 4 / 5" FontSize="11.5" Foreground="#E87A3E"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepTitle4" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StepDetail4" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Page5" Visibility="Collapsed">
                    <TextBlock x:Name="StepNum5" Text="步骤 5 / 5" FontSize="11.5" Foreground="#E87A3E"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepTitle5" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StepDetail5" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 实时捕获状态（向导中可见） -->
            <Border x:Name="LiveBox" Grid.Row="2" VerticalAlignment="Bottom" Margin="20,0,20,12"
                    Background="#19191E" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="LiveText" FontSize="11" Foreground="#5C5C66" TextWrapping="Wrap"
                           Text="等待开始采集…"/>
            </Border>

            <!-- 底栏 -->
            <Grid Grid.Row="3" Margin="20,14,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="取消"
                        HorizontalAlignment="Left" Click="BackButton_Click"/>
                <Button x:Name="MainButton" Grid.Column="1" Click="MainButton_Click" Cursor="Hand"
                        HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="#E87A3E" CornerRadius="8" Padding="16,7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#F08B4F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="B" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="MainButtonText" Text="适配新耳机" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
