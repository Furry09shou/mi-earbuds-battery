<Window x:Class="MiEarbuds.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="适配新耳机" Width="384" Height="556"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModelBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C21"/>
            <Setter Property="Foreground" Value="#EDEDF0"/>
            <Setter Property="CaretBrush" Value="#E87A3E"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#141417" BorderBrush="#2B2B31" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#E87A3E" VerticalAlignment="Center"/>
                    <TextBlock Text="适配新耳机" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="#EDEDF0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- 说明 + 输入 -->
            <StackPanel Grid.Row="1" Margin="20,0,20,0">
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#8F8F98"
                           Text="你的耳机型号暂不受支持？按向导做几个简单动作，软件会记录耳机的广播数据用于破解协议。数据不含个人隐私。"/>
                <TextBlock Text="耳机型号名称" FontSize="11.5" Foreground="#C9C9CF"
                           Margin="0,12,0,6"/>
                <TextBox x:Name="ModelBox" Style="{StaticResource ModelBoxStyle}"
                         Text="例如：Redmi Buds 5"/>
            </StackPanel>

            <!-- 步骤列表 -->
            <StackPanel Grid.Row="2" Margin="20,16,20,0">
                <StackPanel x:Name="Step0" Orientation="Horizontal" Margin="0,0,0,0">
                    <Border x:Name="StepDot0" Width="22" Height="22" CornerRadius="11" Background="#232329">
                        <TextBlock x:Name="StepNum0" Text="1" FontSize="11" Foreground="#8F8F98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepText0" Text="双耳放回充电仓，打开仓盖等 10 秒" FontSize="12.5"
                               Foreground="#8F8F98" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StepDot1" Width="22" Height="22" CornerRadius="11" Background="#232329">
                        <TextBlock x:Name="StepNum1" Text="2" FontSize="11" Foreground="#8F8F98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepText1" Text="取出左耳，等 10 秒（右耳留在仓内）" FontSize="12.5"
                               Foreground="#8F8F98" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StepDot2" Width="22" Height="22" CornerRadius="11" Background="#232329">
                        <TextBlock x:Name="StepNum2" Text="3" FontSize="11" Foreground="#8F8F98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepText2" Text="左耳放回仓内，等 10 秒" FontSize="12.5"
                               Foreground="#8F8F98" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StepDot3" Width="22" Height="22" CornerRadius="11" Background="#232329">
                        <TextBlock x:Name="StepNum3" Text="4" FontSize="11" Foreground="#8F8F98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepText3" Text="取出右耳，等 10 秒（左耳放回）" FontSize="12.5"
                               Foreground="#8F8F98" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step4" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StepDot4" Width="22" Height="22" CornerRadius="11" Background="#232329">
                        <TextBlock x:Name="StepNum4" Text="5" FontSize="11" Foreground="#8F8F98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepText4" Text="右耳放回仓内，等 10 秒" FontSize="12.5"
                               Foreground="#8F8F98" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Step5" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StepDot5" Width="22" Height="22" CornerRadius="11" Background="#232329">
                        <TextBlock x:Name="StepNum5" Text="6" FontSize="11" Foreground="#8F8F98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StepText5" Text="完成，导出数据并上传" FontSize="12.5"
                               Foreground="#8F8F98" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 实时状态 -->
            <Border Grid.Row="4" Margin="20,14,20,0" Background="#19191E" CornerRadius="8" Padding="12,8">
                <TextBlock x:Name="LiveText" FontSize="11" Foreground="#5C5C66"
                           Text="等待开始采集…"/>
            </Border>

            <!-- 底栏 -->
            <Grid Grid.Row="5" Margin="20,14,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButton}" Content="取消" HorizontalAlignment="Left"
                        Click="CloseButton_Click"/>
                <Button x:Name="MainButton" Grid.Column="1" Click="MainButton_Click" Cursor="Hand"
                        HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="#E87A3E" CornerRadius="8" Padding="16,7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#F08B4F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="B" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="MainButtonText" Text="开始采集" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
