<Window x:Class="MiEarbuds.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MiEarbuds.App.UI"
        Title="小米耳机电量" Width="384" Height="448"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="14" Background="#141417"
            BorderBrush="#2B2B31" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#E87A3E" VerticalAlignment="Center"/>
                    <TextBlock Text="小米耳机电量" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="#EDEDF0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" Click="MinButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                            Content="&#xE8BB;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 设备信息头 -->
            <Grid Grid.Row="1" Margin="20,2,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="#6FBF73"/>
                        <TextBlock x:Name="DeviceNameText" Text="正在搜索…" Margin="8,0,0,0"
                                   FontSize="17" FontWeight="SemiBold" Foreground="#EDEDF0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StateText" Margin="16,4,0,0" FontSize="11.5"
                               Foreground="#8F8F98" Text="请打开充电仓盖"/>
                </StackPanel>
                <TextBlock x:Name="MacText" Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0"
                           FontSize="10.5" Foreground="#5C5C66" Text=""/>
            </Grid>

            <!-- 电量卡片 -->
            <Grid x:Name="CardsGrid" Grid.Row="2" Margin="20,0,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左耳 -->
                    <Border x:Name="LeftCard" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:BatteryRing x:Name="LeftRing" Width="86" Height="86"
                                            VerticalAlignment="Center" Level="-1"/>
                            <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                <TextBlock Text="左耳" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#EDEDF0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Path x:Name="LeftBolt" Visibility="Collapsed"
                                          Data="M 7.2 0 L 0.8 8.4 L 4.6 8.4 L 3.6 15 L 10.4 5.6 L 6.4 5.6 Z"
                                          Fill="#E8A33E" Stretch="Uniform" Width="10" Height="12"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LeftStatusText" Margin="0,0,0,0" FontSize="11.5"
                                               Foreground="#8F8F98" Text="--" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右耳 -->
                    <Border x:Name="RightCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:BatteryRing x:Name="RightRing" Width="86" Height="86"
                                            VerticalAlignment="Center" Level="-1"/>
                            <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                <TextBlock Text="右耳" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="#EDEDF0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Path x:Name="RightBolt" Visibility="Collapsed"
                                          Data="M 7.2 0 L 0.8 8.4 L 4.6 8.4 L 3.6 15 L 10.4 5.6 L 6.4 5.6 Z"
                                          Fill="#E8A33E" Stretch="Uniform" Width="10" Height="12"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RightStatusText" FontSize="11.5"
                                               Foreground="#8F8F98" Text="--" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 充电仓 -->
                <Border x:Name="CaseCard" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:BatteryRing x:Name="CaseRing" Width="86" Height="86" Level="-1"/>
                        <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                            <TextBlock Text="充电仓" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#EDEDF0"/>
                            <TextBlock x:Name="CaseStatusText" Margin="0,6,0,0" FontSize="11.5"
                                       Foreground="#8F8F98" Text="--"/>
                            <TextBlock x:Name="CaseHintText" Margin="0,4,0,0" FontSize="10.5"
                                       Foreground="#5C5C66" Text="开盖后可见"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底栏 -->
            <Border Grid.Row="3" BorderBrush="#232329" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="AutoStartCheck" Style="{StaticResource ToggleCheck}"
                              Content="开机自启" Checked="AutoStartCheck_Changed"
                              Unchecked="AutoStartCheck_Changed"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}"
                                Content="检查更新" Click="UpdateButton_Click"/>
                        <Button x:Name="AdaptButton" Style="{StaticResource GhostButton}"
                                Content="适配新耳机" Margin="8,0,0,0" Click="AdaptButton_Click"
                                ToolTip="已适配：Xiaomi Air2 SE&#x0a;其他型号可用采集向导众包适配"/>
                        <Button x:Name="RebindButton" Style="{StaticResource GhostButton}"
                                Content="重新绑定" Margin="8,0,0,0" Click="RebindButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
