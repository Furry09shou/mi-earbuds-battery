<Application x:Class="RonghuiEarbuds.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <!-- 主题画刷默认深色值；ThemeManager.Initialize 会按系统设置覆盖 -->
    <Application.Resources>

        <SolidColorBrush x:Key="T.WindowBg" Color="#141417"/>
        <SolidColorBrush x:Key="T.WindowBorder" Color="#2B2B31"/>
        <SolidColorBrush x:Key="T.CardBg" Color="#1C1C21"/>
        <SolidColorBrush x:Key="T.CardBorder" Color="#2B2B31"/>
        <SolidColorBrush x:Key="T.SoftBg" Color="#19191E"/>
        <SolidColorBrush x:Key="T.HoverBg" Color="#26262C"/>
        <SolidColorBrush x:Key="T.InputBg" Color="#1C1C21"/>
        <SolidColorBrush x:Key="T.InputBorder" Color="#3A3A42"/>
        <SolidColorBrush x:Key="T.SubtleBorder" Color="#232329"/>
        <SolidColorBrush x:Key="T.TextPrimary" Color="#EDEDF0"/>
        <SolidColorBrush x:Key="T.TextSecondary" Color="#8F8F98"/>
        <SolidColorBrush x:Key="T.TextDim" Color="#5C5C66"/>
        <SolidColorBrush x:Key="T.TextGreen" Color="#9FB58A"/>
        <SolidColorBrush x:Key="T.TextOrange" Color="#C98A5A"/>
        <SolidColorBrush x:Key="T.Accent" Color="#E87A3E"/>
        <SolidColorBrush x:Key="T.AccentHover" Color="#F08B4F"/>
        <SolidColorBrush x:Key="T.AccentOn" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="T.RingTrack" Color="#2A2A31"/>
        <SolidColorBrush x:Key="T.ToggleTrackOn" Color="#4A3223"/>
        <SolidColorBrush x:Key="T.Good" Color="#6FBF73"/>
        <SolidColorBrush x:Key="T.Mid" Color="#D9A13B"/>
        <SolidColorBrush x:Key="T.Low" Color="#D96A5B"/>
        <SolidColorBrush x:Key="T.Unknown" Color="#4A4A52"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource T.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource T.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource T.HoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource T.InputBorder}" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource T.HoverBg}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T.TextDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource T.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="{DynamicResource T.InputBorder}"
                                    Background="{DynamicResource T.RingTrack}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource T.TextSecondary}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource T.ToggleTrackOn}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource T.Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource T.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T.TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="20,0,0,0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="2,0,0,0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置页滑杆：细轨道 + 圆形拇指，简洁风 -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource T.RingTrack}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsTabStop="False"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource T.Accent}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
