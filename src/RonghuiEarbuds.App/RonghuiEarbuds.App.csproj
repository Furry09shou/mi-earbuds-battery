<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RonghuiEarbuds</AssemblyName>
    <RootNamespace>RonghuiEarbuds.App</RootNamespace>
    <ApplicationIcon>..\..\assets\RonghuiEarbuds.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <!-- 用户装了更高版本运行时（9/10）也能直接运行，无需恰好是 8 -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- WinForms 仅用于托盘，禁止其全局 using 污染 WPF 代码 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
