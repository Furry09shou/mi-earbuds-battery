<Window x:Class="RonghuiEarbuds.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RonghuiEarbuds.App.UI"
        Title="绒汇耳机助手" Width="384" Height="508"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModelBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource T.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextDim}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource T.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource T.InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="StepTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 设置页分节标题 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextDim}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <!-- 设置页行卡片 -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource T.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource T.SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextPrimary}"/>
        </Style>
        <Style x:Key="SettingSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource T.TextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SettingIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource T.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource T.WindowBg}"
            BorderBrush="{DynamicResource T.WindowBorder}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>

            <!-- ================= 主视图：电量面板 ================= -->
            <Grid x:Name="MainView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource T.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="绒汇耳机助手" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource T.TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="PinButton" Style="{StaticResource TitleBarButton}"
                                Content="&#xE718;" Click="PinButton_Click" ToolTip="窗口置顶"/>
                        <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}"
                                Content="&#xE921;" Click="MinButton_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                                Content="&#xE8BB;" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 设备信息头 -->
                <Grid Grid.Row="1" Margin="20,2,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource T.Good}"/>
                            <TextBlock x:Name="DeviceNameText" Text="正在搜索…" Margin="8,0,0,0"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource T.TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="DeviceSwitchButton" Visibility="Collapsed"
                                    VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand"
                                    Click="DeviceSwitchButton_Click" ToolTip="切换显示的耳机">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                                Padding="5,2">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="{DynamicResource T.TextSecondary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource T.HoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StateText" Margin="16,4,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource T.TextSecondary}" Text="请打开充电仓盖"/>
                        <TextBlock x:Name="SystemBatteryText" Margin="16,3,0,0" FontSize="11"
                                   Foreground="{DynamicResource T.TextGreen}" Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UnadaptedHint" Margin="16,3,0,0" FontSize="11"
                                   Foreground="{DynamicResource T.TextOrange}" Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"
                                   Text="该机型不支持分耳电量 · 仅显示整机电量"
                                   ToolTip="该机型的蓝牙广播不含左右耳电量数据（实测仅发送序列号帧），无法解析分耳电量；系统整机电量来自蓝牙 HFP/AVRCP 上报，与系统蓝牙设置页同源，是当前机型能获得的全部电量信息。可点「适配名单」提交适配申请，等待协议支持。"/>
                    </StackPanel>
                    <TextBlock x:Name="MacText" Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0"
                               FontSize="10.5" Foreground="{DynamicResource T.TextDim}" Text=""/>
                </Grid>

                <!-- 多设备切换弹层 -->
                <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceSwitchButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" VerticalOffset="4">
                    <Border Background="{DynamicResource T.CardBg}" BorderBrush="{DynamicResource T.InputBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="236">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
                        </Border.Effect>
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="DeviceOption_Click" Cursor="Hand" Tag="{Binding}"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" Background="Transparent"
                                                        CornerRadius="7" Padding="10,7" Margin="0,0,0,2">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{Binding Dot}"/>
                                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource T.TextPrimary}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Badge}" Margin="8,0,0,0"
                                                                       FontSize="10" Foreground="{DynamicResource T.TextOrange}"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding BadgeVisibility}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}" Margin="15,2,0,0"
                                                                   FontSize="10.5" Foreground="{DynamicResource T.TextSecondary}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background"
                                                                Value="{DynamicResource T.HoverBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>

                <!-- 电量卡片 -->
                <Grid x:Name="CardsGrid" Grid.Row="2" Margin="20,0,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左耳 -->
                        <Border x:Name="LeftCard" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:BatteryRing x:Name="LeftRing" Width="86" Height="86"
                                                VerticalAlignment="Center" Level="-1"/>
                                <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                    <TextBlock Text="左耳" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource T.TextPrimary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Path x:Name="LeftBolt" Visibility="Collapsed"
                                              Data="M 7.2 0 L 0.8 8.4 L 4.6 8.4 L 3.6 15 L 10.4 5.6 L 6.4 5.6 Z"
                                              Fill="{DynamicResource T.Accent}" Stretch="Uniform" Width="10" Height="12"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LeftStatusText" Margin="0,0,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource T.TextSecondary}" Text="--"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 右耳 -->
                        <Border x:Name="RightCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:BatteryRing x:Name="RightRing" Width="86" Height="86"
                                                VerticalAlignment="Center" Level="-1"/>
                                <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                    <TextBlock Text="右耳" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource T.TextPrimary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Path x:Name="RightBolt" Visibility="Collapsed"
                                              Data="M 7.2 0 L 0.8 8.4 L 4.6 8.4 L 3.6 15 L 10.4 5.6 L 6.4 5.6 Z"
                                              Fill="{DynamicResource T.Accent}" Stretch="Uniform" Width="10" Height="12"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RightStatusText" FontSize="11.5"
                                                   Foreground="{DynamicResource T.TextSecondary}" Text="--"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 充电仓 -->
                    <Border x:Name="CaseCard" Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:BatteryRing x:Name="CaseRing" Width="86" Height="86" Level="-1"/>
                            <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                <TextBlock Text="充电仓" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource T.TextPrimary}"/>
                                <TextBlock x:Name="CaseStatusText" Margin="0,6,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource T.TextSecondary}" Text="--"/>
                                <TextBlock x:Name="CaseHintText" Margin="0,4,0,0" FontSize="10.5"
                                           Foreground="{DynamicResource T.TextDim}" Text="开盖后可见"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 电量统计条：今日已用 / 预计可用 / 当日曲线 -->
                <Border x:Name="StatsBorder" Grid.Row="3" Margin="20,0,20,10"
                        Style="{StaticResource CardBorder}" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="今日已用" FontSize="11"
                                           Foreground="{DynamicResource T.TextSecondary}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="StatsUsedText" Text="--" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource T.TextPrimary}" Margin="6,0,0,0"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="StatsEstimateText" Text="预计可用 --" FontSize="10.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource T.TextGreen}"/>
                        </StackPanel>
                        <Path x:Name="StatsCurve" Grid.Column="2" Width="150" Height="34"
                              Stretch="None" VerticalAlignment="Center"
                              Stroke="{DynamicResource T.Accent}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 底栏 -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource T.SubtleBorder}" BorderThickness="0,1,0,0"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                                HorizontalContentAlignment="Center" Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="设置" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}"
                                    Content="检查更新" Click="UpdateButton_Click"/>
                            <Button x:Name="AdaptButton" Style="{StaticResource GhostButton}"
                                    Content="适配名单" Margin="8,0,0,0" Click="AdaptButton_Click"/>
                            <Button x:Name="RebindButton" Style="{StaticResource GhostButton}"
                                    Content="重新绑定" Margin="8,0,0,0" Click="RebindButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 设置视图（同窗口内跳转） ================= -->
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource T.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="设置" Margin="8,0,0,0" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource T.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                            Click="CloseButton_Click"/>
                </Grid>

                <Grid x:Name="SettingsViews" Grid.Row="1">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SettingsTranslate" Y="0"/>
                    </Grid.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
                    <StackPanel>

                        <TextBlock Text="提醒" Style="{StaticResource SectionHeader}" Margin="2,2,0,6"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="低电量提醒阈值" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="电量低于阈值时弹托盘提醒" Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LowThresholdValue" Text="20%" FontSize="13"
                                               FontWeight="Bold" Foreground="{DynamicResource T.Accent}"
                                               VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                                    <Slider x:Name="LowThresholdSlider" Style="{StaticResource SlimSlider}"
                                            Width="120" Margin="10,0,0,0" Minimum="10" Maximum="50"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="LowThresholdSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="提醒勿扰时段" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="时段内不弹低电量与骤降提醒" Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="QuietHoursButton" Style="{StaticResource GhostButton}"
                                            Content="22:00 – 08:00" Click="QuietHoursButton_Click"
                                            Margin="0,0,10,0"/>
                                    <CheckBox x:Name="QuietHoursCheck" Style="{StaticResource ToggleCheck}"
                                              Checked="QuietHoursCheck_Changed" Unchecked="QuietHoursCheck_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="电量骤降提醒" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="10 分钟内下降超过 20% 时提醒（每小时最多一次）"
                                               Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <CheckBox x:Name="DropAlertCheck" Grid.Column="1" Style="{StaticResource ToggleCheck}"
                                          Checked="DropAlertCheck_Changed" Unchecked="DropAlertCheck_Changed"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="弹窗" Style="{StaticResource SectionHeader}" Margin="2,10,0,6"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开盖自动弹出主窗口" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="耳机开盖广播到达时拉起主面板到最上层" Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <CheckBox x:Name="PopupCheck" Grid.Column="1" Style="{StaticResource ToggleCheck}"
                                          Checked="PopupCheck_Changed" Unchecked="PopupCheck_Changed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CooldownCard" Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="弹窗冷却时间" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="两次弹窗的最小间隔，避免反复打扰" Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CooldownValue" Text="5 分钟" FontSize="12.5"
                                               FontWeight="Bold" Foreground="{DynamicResource T.Accent}"
                                               VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"/>
                                    <Slider x:Name="CooldownSlider" Style="{StaticResource SlimSlider}"
                                            Width="110" Margin="10,0,0,0" Minimum="1" Maximum="30"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="CooldownSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="悬浮条" Style="{StaticResource SectionHeader}" Margin="2,10,0,6"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="显示悬浮电量条" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="可拖动的极简置顶小条；拖动后位置自动记住，双击打开主面板"
                                               Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <CheckBox x:Name="MiniBarCheck" Grid.Column="1" Style="{StaticResource ToggleCheck}"
                                          Checked="MiniBarCheck_Changed" Unchecked="MiniBarCheck_Changed"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="通用" Style="{StaticResource SectionHeader}" Margin="2,10,0,6"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开机自启" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="登录 Windows 后自动启动并收进托盘" Style="{StaticResource SettingSub}"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartCheck" Grid.Column="1" Style="{StaticResource ToggleCheck}"
                                          Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="深浅主题自动跟随 Windows 系统设置，无需手动切换"
                                           Style="{StaticResource SettingSub}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Margin="2,2,0,10"
                                   Foreground="{DynamicResource T.TextDim}"
                                   Text="电量历史仅保存在本机 %APPDATA%\RonghuiEarbuds\history（保留 7 天），用于「今日已用」「预计可用」与当日曲线，不上传任何数据。"/>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 设置视图底栏 -->
                <Grid Grid.Row="2" Margin="20,8,20,14">
                    <Button x:Name="SettingsBackButton" Style="{StaticResource GhostButton}" Content="‹ 返回"
                            HorizontalAlignment="Left" Click="SettingsBackButton_Click"/>
                </Grid>
            </Grid>

            <!-- ================= 适配视图：名单 + 分页向导（同窗口内跳转） ================= -->
            <Grid x:Name="AdapterView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource T.Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdapterTitle" Text="适配名单" Margin="8,0,0,0" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource T.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- 进度点 -->
                <StackPanel x:Name="DotsRow" Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"/>

                <!-- 视图容器 -->
                <Grid x:Name="AdapterViews" Grid.Row="2" Margin="20,0,20,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="AdapterTranslate" Y="0"/>
                    </Grid.RenderTransform>

                    <!-- 名单页 -->
                    <StackPanel x:Name="AdapterListPage">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource T.TextSecondary}"
                                   Text="绿色机型已完成协议适配，红色机型因设备原因无法适配。"/>
                        <ItemsControl x:Name="ModelList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource T.SoftBg}" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="IconBg" Width="20" Height="20" CornerRadius="10"
                                                        Background="#243A28">
                                                    <TextBlock x:Name="IconGlyph" Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource T.Good}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource T.TextPrimary}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeBg" Background="#243A28" CornerRadius="5"
                                                        Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="BadgeText" Text="已支持" FontSize="10"
                                                               Foreground="{DynamicResource T.Good}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="NoteText" Text="{Binding Note}" FontSize="10.5"
                                                       Margin="30,4,0,0" Visibility="Collapsed"
                                                       Foreground="{DynamicResource T.TextDim}"
                                                       TextWrapping="Wrap" MaxWidth="300"
                                                       TextOptions.TextFormattingMode="Ideal"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Supported}" Value="False">
                                            <Setter TargetName="NoteText" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="IconBg" Property="Background" Value="#3A2626"/>
                                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xE711;"/>
                                            <Setter TargetName="IconGlyph" Property="Foreground"
                                                    Value="{DynamicResource T.Low}"/>
                                            <Setter TargetName="BadgeBg" Property="Background" Value="#3A2626"/>
                                            <Setter TargetName="BadgeText" Property="Text" Value="不支持分耳"/>
                                            <Setter TargetName="BadgeText" Property="Foreground"
                                                    Value="{DynamicResource T.Low}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource T.TextSecondary}"
                                   Margin="0,4,0,0"
                                   Text="没找到你的耳机？点右下角「适配新耳机」，按向导采集广播数据即可众包适配。"/>
                    </StackPanel>

                    <!-- 向导页 0：写入型号 -->
                    <StackPanel x:Name="AdapterPage0" Visibility="Collapsed">
                        <TextBlock Text="先写下耳机型号" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource T.TextPrimary}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource T.TextSecondary}"
                                   Margin="0,8,0,0"
                                   Text="你的耳机型号暂不受支持？按向导做几个简单动作，软件会记录耳机的广播数据。数据不含个人隐私，导出后上传到 GitHub 供开发者分析适配。"/>
                        <TextBlock Text="耳机型号名称" FontSize="11.5" Foreground="{DynamicResource T.TextPrimary}"
                                   Margin="0,14,0,6"/>
                        <TextBox x:Name="ModelBox" Style="{StaticResource ModelBoxStyle}"
                                 Text="例如：Redmi Buds 5"
                                 GotFocus="ModelBox_GotFocus" LostFocus="ModelBox_LostFocus"/>
                        <TextBlock x:Name="ModelHint" Text="请先填写耳机型号" FontSize="11"
                                   Foreground="{DynamicResource T.Low}"
                                   Margin="2,6,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="耳机形态" FontSize="11.5" Foreground="{DynamicResource T.TextPrimary}"
                                   Margin="0,16,0,2"/>
                        <StackPanel>
                            <RadioButton x:Name="LayoutOptionDualCase" GroupName="DeviceLayout" IsChecked="True"
                                         Content="双耳 + 充电仓（常见真无线）" FontSize="12.5"
                                         Foreground="{DynamicResource T.TextPrimary}" Margin="0,3,0,0"/>
                            <RadioButton x:Name="LayoutOptionDualNoCase" GroupName="DeviceLayout"
                                         Content="仅双耳，无充电仓或仓不广播电量" FontSize="12.5"
                                         Foreground="{DynamicResource T.TextPrimary}" Margin="0,3,0,0"/>
                            <RadioButton x:Name="LayoutOptionMono" GroupName="DeviceLayout"
                                         Content="仅单耳耳机，无充电仓" FontSize="12.5"
                                         Foreground="{DynamicResource T.TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource T.TextDim}"
                                   Margin="0,8,0,0"
                                   Text="形态决定采集动作与电量字段数量（单耳没有左右之分；无仓形态不会出现充电仓电量字段）。选择会随数据一起提交，帮助开发者正确识别布局。"/>
                    </StackPanel>

                    <!-- 向导页 1-5：动作步骤 -->
                    <StackPanel x:Name="AdapterPage1" Visibility="Collapsed">
                        <TextBlock x:Name="StepNum1" Text="步骤 1 / 5" FontSize="11.5"
                                   Foreground="{DynamicResource T.Accent}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StepTitle1" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StepDetail1" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AdapterPage2" Visibility="Collapsed">
                        <TextBlock x:Name="StepNum2" Text="步骤 2 / 5" FontSize="11.5"
                                   Foreground="{DynamicResource T.Accent}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StepTitle2" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StepDetail2" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AdapterPage3" Visibility="Collapsed">
                        <TextBlock x:Name="StepNum3" Text="步骤 3 / 5" FontSize="11.5"
                                   Foreground="{DynamicResource T.Accent}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StepTitle3" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StepDetail3" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AdapterPage4" Visibility="Collapsed">
                        <TextBlock x:Name="StepNum4" Text="步骤 4 / 5" FontSize="11.5"
                                   Foreground="{DynamicResource T.Accent}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StepTitle4" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StepDetail4" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AdapterPage5" Visibility="Collapsed">
                        <TextBlock x:Name="StepNum5" Text="步骤 5 / 5" FontSize="11.5"
                                   Foreground="{DynamicResource T.Accent}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StepTitle5" Style="{StaticResource StepTitleStyle}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StepDetail5" Style="{StaticResource StepDetailStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 实时捕获状态（采集动作页显示） -->
                <Border x:Name="LiveBox" Grid.Row="2" VerticalAlignment="Bottom" Margin="20,0,20,12"
                        Background="{DynamicResource T.SoftBg}" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="LiveText" FontSize="11" Foreground="{DynamicResource T.TextDim}"
                               TextWrapping="Wrap" Text="等待开始采集…"/>
                </Border>

                <!-- 适配视图底栏 -->
                <Grid Grid.Row="3" Margin="20,12,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AdapterBackButton" Style="{StaticResource GhostButton}" Content="取消"
                            HorizontalAlignment="Left" Click="AdapterBackButton_Click"/>
                    <Button x:Name="AdapterMainButton" Grid.Column="1" Click="AdapterMainButton_Click" Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Background="{DynamicResource T.Accent}" CornerRadius="8" Padding="16,7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource T.AccentHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="B" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="AdapterMainButtonText" Text="适配新耳机 ›" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource T.AccentOn}"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
